# Copy to .env (gitignored, never commit it) and fill in the credentials for
# the stores you publish to. Each section is only needed by its own script.

# ── Chrome Web Store (publish-extension.mjs chrome) ─────────────────────────

# Pick ONE way to authenticate as the service account linked in the dashboard.
#
# a) Impersonation through gcloud (recommended, no key file). Needs
#    `gcloud auth login` and the Service Account Token Creator role:
CWS_SERVICE_ACCOUNT=
#
# b) A JSON key for the service account, as a path (keep it outside the repo)
#    or as the file's contents in single quotes:
# CWS_SERVICE_ACCOUNT_KEY_PATH=/Users/you/.config/cws/service-account.json
# CWS_SERVICE_ACCOUNT_KEY='{"type":"service_account",...}'

# Only needed if these ever change -- publish-extension.mjs already defaults
# to this project's values:
# CWS_PUBLISHER_ID=6452897e-23a2-4474-82bf-cbe87fcfc7f7
# CWS_ITEM_ID=denpnpcgjgikjpoglpjefakmdcbmlgih

# ── addons.mozilla.org (publish-extension.mjs firefox) ──────────────────────

# From https://addons.mozilla.org/developers/addon/api/key/
# The key is the "JWT issuer" (user:12345:67), the secret is the "JWT secret".
AMO_API_KEY=
AMO_API_SECRET=

# ── App Store Connect (publish-extension.mjs safari, upload-safari-build.sh) ─

# Pick ONE way to provide the API key (or store it in the Keychain instead,
# with ./upload-safari-build.sh --store-key-in-keychain AuthKey_<KEY_ID>.p8):
#
# a) The path to your AuthKey_<KEY_ID>.p8 file (keep it outside the repo):
# ASC_API_KEY_PATH=/Users/you/.config/asc/AuthKey_B78MTCSY2V.p8
#
# b) The full contents of that file, quoted:
ASC_API_KEY="-----BEGIN PRIVATE KEY-----
...
-----END PRIVATE KEY-----"

# Only needed if these ever change -- both scripts default to this project's
# values. After rotating the key, set ASC_KEY_ID to the new key's ID:
# ASC_KEY_ID=B78MTCSY2V
# ASC_ISSUER_ID=69a6de6f-b54e-47e3-e053-5b8c7c11a4d1
# ASC_TEAM_ID=58S46496RD
