{
  "name": "cross-origin-storage-extension",
  "version": "0.1.25",
  "description": "<img src=\"https://raw.githubusercontent.com/web-ai-community/cross-origin-storage-extension/refs/heads/main/logo-cos.svg\" alt=\"Cross-Origin Storage API logo\" width=\"60\" height=\"60\">",
  "main": "background.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "start": "npx http-server docs/",
    "pretest": "npm run use-chrome && node check-fixture-hashes.mjs",
    "check:hashes": "node check-fixture-hashes.mjs",
    "test": "node e2e-test.chrome.mjs",
    "use-chrome": "cp manifest.chrome.json manifest.json",
    "use-firefox": "cp manifest.firefox.json manifest.json",
    "use-safari": "cp manifest.safari.json manifest.json",
    "build:chrome": "bash zip-extension.sh chrome",
    "build:firefox": "bash zip-extension.sh firefox",
    "build:safari": "bash zip-extension.sh safari",
    "release:chrome": "node publish-extension.mjs chrome",
    "release:firefox": "node publish-extension.mjs firefox",
    "release:safari": "node publish-extension.mjs safari"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/web-ai-community/cross-origin-storage-extension.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/web-ai-community/cross-origin-storage-extension/issues"
  },
  "homepage": "https://github.com/web-ai-community/cross-origin-storage-extension#readme",
  "devDependencies": {
    "playwright": "^1.63.0"
  }
}
