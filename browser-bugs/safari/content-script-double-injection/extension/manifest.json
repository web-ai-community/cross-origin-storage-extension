{
  "manifest_version": 3,
  "name": "Repro: content script injected twice",
  "version": "1.0",
  "description": "Counts how often its content scripts run in each document.",
  "background": {
    "page": "background.html",
    "persistent": false
  },
  "content_scripts": [
    {
      "matches": ["http://localhost/*"],
      "js": ["main-counter.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": ["http://localhost/*"],
      "js": ["counter.js", "lexical.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
